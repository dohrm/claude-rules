{
  "skill": "runbook",
  "rules": [
    "agent"
  ],
  "prompt": "Write the runbook. BAD (the fake agent writes an unusable one on this word).",
  "artifacts": {
    "docs/runbook/*.md": {
      "matches": [
        "checkout-killswitch-off",
        "(?i)^##\\s*First move",
        "(?i)^##\\s*Do NOT"
      ],
      "not_matches": [
        "(?i)\\bTODO\\b"
      ],
      "max_words": 200
    }
  }
}
