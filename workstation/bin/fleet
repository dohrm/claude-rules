#!/usr/bin/env node

// fleet — one line per registered bench, sorted so what waits on you is line 1.
//
// Reads three sources, each answering exactly one question and none redundant:
//
//   the registry            which benches are OPEN, and where they are
//   zellij list-sessions    which one is LIVE right now
//   .work/<slug>/*.md       where it stands, and whether it is blocked on you
//
// The registry is durable on purpose: work waiting on you does not stop waiting
// because you closed a terminal, so a bench stays listed until `bench done`.
//
// Read-only, no LLM, ALWAYS exits 0. It reports; the gate stays `just review-guard`,
// inside each bench, at push time.

import { existsSync } from 'node:fs'
import { REGISTRY, age, baseRef, git, loopState, readBenches, reviewState, sessionState, sessions } from '../lib.mjs'

if (process.argv.includes('-h') || process.argv.includes('--help')) {
  console.log('fleet — overview of every registered bench. Register one with `bench start <path>`.')
  console.log(`\nBenches live in ${REGISTRY} — one JSON file each, yours to back up or edit.`)
  process.exit(0)
}

const benches = readBenches()
if (!benches.length) {
  console.log(`No bench registered (${REGISTRY}).\n  bench start .          open one here\n  bench register <path>  add one driven from a GUI host`)
  process.exit(0)
}

const zj = sessions()

const rows = benches.map((rec) => {
  if (!existsSync(rec.path)) {
    return {
      name: rec.name, branch: '(gone)', ahead: '—', dirty: '—', loop: '—', age: '—',
      review: '—', session: 'gone', mtime: null, file: null, path: rec.path,
      blocked: [`path no longer exists: ${rec.path} — \`bench done ${rec.name}\``],
    }
  }
  const base = baseRef(rec.path)
  const ahead = base ? git(rec.path, 'rev-list', '--count', `${base}..HEAD`) : null
  const porcelain = git(rec.path, 'status', '--porcelain')
  const dirty = porcelain === null ? null : porcelain.split('\n').filter((l) => l.trim()).length
  const loop = loopState(rec.path)
  const session = sessionState(rec.session || rec.name, zj)
  return {
    name: rec.name,
    path: rec.path,
    branch: git(rec.path, 'rev-parse', '--abbrev-ref', 'HEAD') ?? '(no git)',
    ahead: ahead === null ? '—' : `+${ahead}`,
    dirty: dirty === null ? '?' : dirty === 0 ? 'clean' : `${dirty} dirty`,
    loop: loop.progress ? `${loop.progress.done}/${loop.progress.total} ${loop.label}` : loop.label,
    age: age(loop.mtime),
    review: reviewState(rec.path),
    session,
    blocked: loop.blocked,
    mtime: loop.mtime,
    file: loop.file,
  }
})

// Blocked first, then stalest first: line 1 is what has been rotting longest.
rows.sort((a, b) => {
  if (!!a.blocked.length !== !!b.blocked.length) return a.blocked.length ? -1 : 1
  return (a.mtime ?? 0) - (b.mtime ?? 0)
})

const COLS = [
  ['name', 'BENCH'], ['branch', 'BRANCH'], ['ahead', '±'], ['dirty', 'DIRTY'],
  ['loop', 'LOOP'], ['age', 'AGE'], ['review', 'REVIEW'], ['session', 'STATE'],
]
// Width in characters, not bytes: the em-dash placeholders are multi-byte.
const chars = (s) => [...String(s)].length
const width = Object.fromEntries(
  COLS.map(([key, head]) => [key, Math.max(chars(head), ...rows.map((r) => chars(r[key])))]),
)
const pad = (s, w) => String(s) + ' '.repeat(Math.max(0, w - chars(s)))
const line = (get) => COLS.map(([key]) => pad(get(key), width[key])).join('  ')

const YELLOW = '\u001b[33m'
const RESET = '\u001b[0m'
const color = process.stdout.isTTY && !process.env.NO_COLOR

// A real escalation is a paragraph — `hal` carries eighty of them. Printing them
// whole turns the dashboard into the document it is supposed to point at, so each
// blocker gets one clipped line and the rest gets a count and a path.
const SHOWN = 2
const term = process.stdout.columns || 100
const clip = (s, w) => (chars(s) <= w ? s : `${[...s].slice(0, Math.max(8, w - 1)).join('')}…`)

console.log(line((key) => COLS.find(([k]) => k === key)[1]))
for (const r of rows) {
  const text = line((key) => r[key])
  console.log(r.blocked.length && color ? `${YELLOW}${text}${RESET}` : text)
  for (const b of r.blocked.slice(0, SHOWN)) console.log(`    ! ${clip(b, term - 6)}`)
  if (r.blocked.length > SHOWN)
    console.log(`    … +${r.blocked.length - SHOWN} more — ${r.file ?? 'see the worklist'}`)
}

// `dormant` (registered, no session) and `exited` (the name is still owned, so
// attaching resurrects it) need DIFFERENT commands. Printing `zellij attach` for a
// dormant bench sends you straight to "No session with the name ... found!" — which
// is exactly how this was found, in the field, after the tests had passed.
function remedy(r) {
  if (r.session === 'live') return 'already live'
  if (r.session === 'exited') return `zellij attach ${r.name}`
  if (r.session === 'no zellij') return `no zellij here — read ${r.file ?? 'its worklist'} directly`
  return `cd ${r.path} && bench start .`
}

const waiting = rows.filter((r) => r.blocked.length)
if (waiting.length) {
  console.log(`\n${waiting.length} bench(es) waiting on you — answer inside the bench, not here:`)
  for (const r of waiting) console.log(`    ${r.name}: ${remedy(r)}`)
}
