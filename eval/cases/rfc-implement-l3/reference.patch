diff --git a/test/archive.test.mjs b/test/archive.test.mjs
new file mode 100644
index 0000000..e8a4650
--- /dev/null
+++ b/test/archive.test.mjs
@@ -0,0 +1,66 @@
+import { test } from 'node:test'
+import assert from 'node:assert/strict'
+import { mkdtempSync, writeFileSync, readFileSync, copyFileSync } from 'node:fs'
+import { tmpdir } from 'node:os'
+import { join, dirname } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { spawnSync } from 'node:child_process'
+import { archiveTask, restoreTask, TaskError } from '../src/tasks.mjs'
+
+const HERE = dirname(fileURLToPath(import.meta.url))
+const BIN = join(dirname(HERE), 'bin', 'tasks.mjs')
+const tmpFile = () => join(mkdtempSync(join(tmpdir(), 'tasks-')), 'tasks.json')
+const ids = (out) => [...out.matchAll(/#(\d+)/g)].map(m => Number(m[1]))
+
+function cli(file, ...args) {
+  const r = spawnSync(process.execPath, [BIN, ...args], { encoding: 'utf8', env: { ...process.env, TASKS_FILE: file } })
+  return { status: r.status, out: r.stdout.trim(), err: r.stderr.trim() }
+}
+
+test('archive hides a task from the list, restore brings it back', () => {
+  const file = tmpFile()
+  cli(file, 'add', 'a'); cli(file, 'add', 'b')
+  assert.equal(cli(file, 'archive', '1').status, 0)
+  assert.deepEqual(ids(cli(file, 'list').out), [2])
+  assert.deepEqual(ids(cli(file, 'list', '--archived').out), [1])
+  assert.equal(cli(file, 'restore', '1').status, 0)
+  assert.deepEqual(ids(cli(file, 'list').out), [1, 2])
+  assert.equal(cli(file, 'list', '--archived').out, 'no archived tasks')
+})
+
+test('an id is never handed out twice — not after archive, not after rm', () => {
+  const file = tmpFile()
+  for (const t of ['a', 'b', 'c']) cli(file, 'add', t)
+  cli(file, 'archive', '3')
+  assert.match(cli(file, 'add', 'd').out, /#4\b/)
+  cli(file, 'rm', '4')
+  assert.match(cli(file, 'add', 'e').out, /#5\b/)
+})
+
+test('a v1 file migrates on the first save: ids, done states and the counter carry over', () => {
+  const file = tmpFile()
+  copyFileSync(join(HERE, 'v1-sample.json'), file)
+  assert.match(cli(file, 'add', 'new').out, /#4\b/, 'ids 1 and 3 exist: the next one is 4')
+  const data = JSON.parse(readFileSync(file, 'utf8'))
+  assert.equal(data.version, 2)
+  assert.equal(data.nextId, 5)
+  assert.deepEqual(data.tasks.map(t => [t.id, t.done, t.archived]), [[1, true, false], [3, false, false], [4, false, false]])
+})
+
+test('archive and restore refuse a task in the wrong state', () => {
+  const state = { nextId: 2, tasks: [{ id: 1, title: 'a', done: false, archived: false }] }
+  assert.throws(() => restoreTask(state, 1), /not archived/)
+  const archived = archiveTask(state, 1).state
+  assert.throws(() => archiveTask(archived, 1), /already archived/)
+  assert.throws(() => archiveTask(state, 9), TaskError)
+})
+
+test('a file of an unknown version, or with a counter behind its ids, is refused', () => {
+  const file = tmpFile()
+  writeFileSync(file, JSON.stringify({ version: 3, tasks: [] }))
+  assert.equal(cli(file, 'list').status, 1)
+  writeFileSync(file, JSON.stringify({ version: 2, nextId: 2, tasks: [{ id: 2, title: 'a', done: false, archived: false }] }))
+  const r = cli(file, 'add', 'b')
+  assert.equal(r.status, 1)
+  assert.match(r.err, /nextId/)
+})
