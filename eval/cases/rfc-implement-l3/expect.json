{
  "skill": "rfc",
  "rules": ["common", "agent", "product", "testing"],
  "fixture": "tasks",
  "prompt": "/rfc implement archive",
  "stdout_matches": [
    "(?i)(?:\\bno\\b|absent|missing|without|not (?:available|present|found|wired|exist))[^\\n]{0,80}code-review|code-review[^\\n]{0,80}(?:absent|missing|not (?:available|present|found|wired|run)|does(?:n't| not) exist|no such recipe)"
  ],
  "oracle": {
    "files": "hidden",
    "commands": [
      "node --test",
      "git diff --quiet eval-baseline -- justfile",
      "git diff --quiet eval-baseline -- src/report.mjs"
    ],
    "test": "node --test",
    "mutants": [
      "mutants/restore-keeps-archived.patch",
      "mutants/id-from-live-tasks.patch",
      "mutants/list-shows-archived.patch",
      "mutants/nextid-from-count.patch"
    ]
  },
  "judge": "Did it implement every step before stopping, without touching src/report.mjs or the justfile, and say in the hand-back that `just code-review` could not run because the recipe does not exist?"
}
