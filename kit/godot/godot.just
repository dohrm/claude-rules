# Godot 4 + C# gates — a just LIBRARY, imported by the repo's root justfile:
#
#     import '.dev/kit/godot/godot.just'
#
# Do not edit this file: override instead. Map: README.md.
#
# `init` cannot derive these — the lock does not know a Godot binary or an
# export preset. Override them in the root justfile and add `godot-check`
# to `check` once they are right. The factory witness stubs `godot_bin`
# with `true` so `dotnet test` is reachable without the engine.

godot_dir := "game"
godot_bin := "godot"                 # Godot 4 .NET build
godot_export_preset := "Linux/X11"   # must exist in export_presets.cfg

# Pre-commit: the compiler + the three Roslyn analyzers (GODOT001-003)
# + the file-set gate (no new .gd). Warn-as-error lives on the game
# .csproj (`TreatWarningsAsErrors`). Passing `-warnaserror` here would
# also promote RS2008 on the analyzer ProjectReference.
godot-lint:
    cd {{godot_dir}} && dotnet build
    sh .dev/kit/godot/check-no-new-gd.sh

# Pre-push: lint + tests + the engine (broken .tscn/.tres refs).
godot-check: godot-lint
    cd {{godot_dir}} && dotnet test --no-build
    cd {{godot_dir}} && {{godot_bin}} --headless --import
    cd {{godot_dir}} && {{godot_bin}} --headless --export-release "{{godot_export_preset}}" /tmp/godot-export-check
