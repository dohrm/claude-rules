# TypeScript Node (Fastify) gates — a just LIBRARY:
#
#     import '.dev/kit/ts-node/ts-node.just'
#
# Do not edit this file: override instead. Copy eslint.node.js →
# eslint.config.js and tsconfig.node.json → tsconfig.json. Map: README.md.

ts_node_dir := "."   # overridden from the root justfile (managed block)

ts-node-lint:
    cd {{ts_node_dir}} && npm exec --no-install -- eslint .
ts-node-check: ts-node-lint
    cd {{ts_node_dir}} && npm exec --no-install -- tsc --noEmit
    cd {{ts_node_dir}} && npm exec --no-install -- vitest run

ts-node-mutate:
    cd {{ts_node_dir}} && npm exec --no-install -- stryker run --incremental
