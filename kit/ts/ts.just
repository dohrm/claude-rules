# TypeScript language floor — a just LIBRARY, imported by the repo's root justfile:
#
#     import '.dev/kit/ts/ts.just'
#
# `claude-rules init` writes that line for you. Do not edit this file: override
# instead. A recipe or variable in the root justfile wins over an imported one.
#
# This is the floor (shared package, no React, no Node DOM). A React portal
# installs `ts-web` or `ts-tauri`; a Fastify service installs `ts-node`.
# Recipes name the tools. Copy eslint.base.js → eslint.config.js and
# tsconfig.base.json → tsconfig.json. Map: README.md.
#
# `npm exec --no-install` is the lock: the gate runs the binaries in
# node_modules, never a floating npx download. `npm ci` belongs in CI
# before `just ts-check`, not in these recipes.

ts_dir := "."      # overridden from the root justfile (managed block)

ts-lint:
    cd {{ts_dir}} && npm exec --no-install -- eslint .
ts-check: ts-lint
    cd {{ts_dir}} && npm exec --no-install -- tsc --noEmit
    cd {{ts_dir}} && npm exec --no-install -- vitest run

# StrykerJS has no `--since`: it has `--incremental`. First run full; later
# runs reuse the report. Needs @stryker-mutator/core + a runner, then
# `npx stryker init`. Gitignore reports/.
ts-mutate:
    cd {{ts_dir}} && npm exec --no-install -- stryker run --incremental
