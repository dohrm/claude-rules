# TypeScript web (React) gates — a just LIBRARY:
#
#     import '.dev/kit/ts-web/ts-web.just'
#
# Do not edit this file: override instead. Copy eslint.react.js →
# eslint.config.js and tsconfig.web.json → tsconfig.json. Map: README.md.

ts_web_dir := "."   # overridden from the root justfile (managed block)

ts-web-lint:
    cd {{ts_web_dir}} && npm exec --no-install -- eslint .
ts-web-check: ts-web-lint
    cd {{ts_web_dir}} && npm exec --no-install -- tsc --noEmit
    cd {{ts_web_dir}} && npm exec --no-install -- vitest run

ts-web-mutate:
    cd {{ts_web_dir}} && npm exec --no-install -- stryker run --incremental
